# ◆ JH · SUTT·LEITSTAND · Umgebungsvariablen (Kopie als .env anlegen)
#
# Google Maps JavaScript API – ohne Schlüssel zeigt die Akte eine
# MapLibre-/OpenStreetMap-Karte, ohne Netz eine Schemakarte.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: Map-ID mit eigenem Kartenstil (Graustufen) aus der Cloud-Konsole.
VITE_GOOGLE_MAPS_MAP_ID=
