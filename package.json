{
  "name": "sutt-leitstand",
  "private": true,
  "version": "2.1.6",
  "description": "SUTT Leitstand – Branchensoftware Sutt AG · Disposition, Aussendienst, Aufträge, Kunden, Geräte, Bilder, Lager, Personal (Mockup) · Techniker-App in app/, Website in webseite/",
  "author": "◆ JH",
  "type": "module",
  "workspaces": ["app", "webseite"],
  "scripts": {
    "dev": "vite",
    "dev:app": "npm run dev --workspace app",
    "dev:web": "npm run dev --workspace webseite",
    "dev:alle": "node scripts/dev-alle.mjs",
    "build": "tsc --noEmit && vite build",
    "build:app": "npm run build --workspace app",
    "build:web": "npm run build --workspace webseite",
    "build:alle": "npm run build && npm run build:app && npm run build:web",
    "preview": "vite preview",
    "pages:build": "npm run build && npm run build:app && npm run build:web && node scripts/pages-site.mjs",
    "pages:site": "node scripts/pages-site.mjs",
    "pages:serve": "node scripts/pages-serve.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:alle": "tsc --noEmit && npm run typecheck --workspace app && npm run typecheck --workspace webseite",
    "test": "vitest run",
    "test:app": "npm run test --workspace app",
    "test:alle": "vitest run && npm run test --workspace app",
    "test:watch": "vitest",
    "jh:sign": "node scripts/jh-sign.mjs",
    "jh:check": "node scripts/jh-sign.mjs --check",
    "jh:contrast": "node scripts/contrast.jh.ts",
    "demo:video": "node scripts/demo.jh.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.14.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
